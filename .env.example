# API Authentication
# Used for authenticating requests to the screening API
API_KEY=your_api_key_here

# Anthropic API
# Required for Claude API calls
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Axiom Logging
# For logging screening results (optional but recommended)
AXIOM_TOKEN=xaat-xxx
AXIOM_DATASET=ansa-data

# MCP Server URL
# For local dev: http://localhost:3000
# For production: Set to your Heroku app URL (e.g., https://your-app.herokuapp.com)
MCP_BASE_URL=http://localhost:3000

# Google Maps API
# Required for distance calculations
GOOGLE_MAPS_API_KEY=AIza-xxx

# Consolidated Screening List API
# Required for sanctions/denied parties lookups
CONSOLIDATED_SCREENING_LIST_API_KEY=xxx

# Server Port (optional, defaults to 3000)
PORT=3000
